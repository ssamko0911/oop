<h1>Password generation</h1>

<form action="{{ path('password') }}" method="post">
    <label for="special_symbols">Strong password</label>
    <input type="checkbox" id="special_symbols" name="special_symbols" value="1">
    <br />

    <label for="numbers">Numbers</label>
    <input type="checkbox" id="numbers" name="numbers" value="1">
    <br />

    <label for="length">Password length:</label>
    <input type="text" id="length" name="length">
    <br />

    <button type="submit">Generate</button>

{#    {% block form_errors %}#}
{#        #}{#smth#}
{#    {% endblock %}#}

    {% for type, messages in app.flashes %}
        {% for message in messages %}
            <div class="alert alert-{{ type }}">{{ message }}</div>
        {% endfor %}
    {% endfor %}

